    <!-- Charge level from the vehicle -->
    <string name="phone_carhardware_title">Ladestand aus dem Fahrzeug</string>
    <string name="phone_carhardware_intro">Android Auto kann den Ladestand vom Fahrzeug liefern. Ob es das tut, entscheidet das Head-Unit — die wenigsten geben die Daten heraus. Geprüft werden kann das nur im Auto; das Ergebnis der letzten Verbindung steht hier.</string>
    <string name="phone_carhardware_never">Noch nie geprüft. Die App war noch nicht mit Android Auto verbunden.</string>
    <string name="phone_carhardware_checked">Zuletzt geprüft vor %1$s</string>
    <string name="phone_carhardware_available">Das Fahrzeug liefert den Ladestand (%1$s). Er hat Vorrang vor der Eingabe.</string>
    <string name="phone_carhardware_no_data">Das Head-Unit liefert keinen Ladestand (%1$s). Es gilt der eingetippte Wert.</string>
    <string name="phone_carhardware_no_permission">Die Berechtigung für Fahrzeugdaten fehlt. Sie lässt sich nur im Auto erteilen.</string>
    <string name="phone_carhardware_no_hardware">Dieses Head-Unit bietet keine Fahrzeugdaten an.</string>
